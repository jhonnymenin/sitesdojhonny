# ─────────────────────────────────────────────────────────────────────────────
# Supabase — chaves PÚBLICAS (vão para o navegador de propósito)
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# As mesmas, sem o prefixo VITE_, para o lado servidor.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — chave de SERVIÇO. **Segredo de verdade.**
#
# Sem prefixo VITE_ de propósito: variável com esse prefixo é embutida no bundle
# do navegador, e esta chave ignora as políticas de RLS — quem a tivesse leria e
# escreveria qualquer tabela do projeto.
#
# Não vinha no .env do Lovable (eles injetavam no ambiente deles). **A inscrição
# não funciona sem ela**: é o que o src/integrations/supabase/client.server.ts
# usa para gravar em `registrations` e `coupons`.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets — espelho das inscrições.
#
# ⚠️ Esta integração passa pelo **gateway do Lovable**
# (connector-gateway.lovable.dev) e **não funciona fora de lá**. Ver
# src/lib/sheets.server.ts. O código falha de forma tolerante: a inscrição é
# gravada no Supabase de qualquer jeito e só o espelho na planilha para — em
# silêncio, o que é o risco.
LOVABLE_API_KEY=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_REGISTRATIONS_ID=
