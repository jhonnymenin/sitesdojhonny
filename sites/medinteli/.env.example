# Rastreamento — deixe VAZIO enquanto esta pasta for apenas o espelho do site
# que roda no Lovable. Vazios, GA4 e Pixel não são carregados e nenhum evento é
# enviado — nem pelo navegador, nem pela Conversions API.
VITE_GA4_ID=
# valor de produção: G-R71GQ8HMR7
VITE_META_PIXEL_ID=
# valor de produção: 927463216939252

# Supabase — hospeda a Edge Function fb-conversions (Conversions API da Meta).
# Chaves publishable/anon; os valores estão no painel do projeto no Lovable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
