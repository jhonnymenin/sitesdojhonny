# Rastreamento — Meta Pixel + Conversions API
#
# Deixe VAZIO enquanto esta cópia for apenas o espelho do site que roda no
# Lovable. Sem o ID do pixel, o rastreamento inteiro fica inerte e nenhum evento
# de teste suja os dados da campanha em produção.
#
# Para ligar (quando este passar a ser o site no ar):
VITE_META_PIXEL_ID=
# valor de produção: 553465707797085

# Token da Conversions API (server-side). Vem do Gerenciador de Eventos da Meta.
META_CAPI_ACCESS_TOKEN=

# Captura de leads na planilha Google, via gateway do Lovable.
LOVABLE_API_KEY=
GOOGLE_SHEETS_API_KEY=
